{
  "name": "khaled-erp",
  "private": true,
  "version": "1.0.0",
  "description": "نظام إدارة المبيعات والمخزون والحسابات المتكامل للمنشآت والشركات",
  "author": "Khaled",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder",
    "electron:publish": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.0.0",
    "@supabase/supabase-js": "^2.50.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "electron-updater": "^6.3.9",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.khaled.erp",
    "productName": "ERP System",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "khaledwagih78",
        "repo": "mobile-shop"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERP System"
    }
  }
}
