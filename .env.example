# Supabase Configuration
# Replace these with your client's Supabase project credentials:
# Found at: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Shop owner cloud account (REQUIRED only when using the secured schema +
# public storefront). Create this user once in Supabase: Authentication ->
# Users -> Add user (tick "Auto Confirm User"), then put the same email +
# password here. The app signs in with it automatically before each sync.
# Leave blank to keep the old open (no-login) sync behaviour.
VITE_SUPABASE_OWNER_EMAIL=owner@theshop.example
VITE_SUPABASE_OWNER_PASSWORD=change-me

# Google Gemini AI Configuration (Strict Analyze-Only, locked from user editing)
VITE_GEMINI_API_KEY=your-google-gemini-api-key
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
