# =====================================================================
# خالد لصيانة المحمول — متغيرات البيئة
# انسخ الملف إلى .env.local (ولا ترفعه على GitHub أبداً)
# =====================================================================

# ---- Supabase (عام — آمن في الواجهة، محمي بـ RLS) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# رابط الموقع المنشور (يُستخدم في روابط المتابعة والـ QR)
NEXT_PUBLIC_SITE_URL=

# ---- سري — Edge Functions / الخادم فقط (supabase secrets set ...) ----
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=ar

# Firebase Cloud Messaging (HTTP v1) — حساب خدمة JSON كامل في سطر واحد
FCM_SERVICE_ACCOUNT_JSON=

# ---- الاختبارات المحلية فقط ----
# قاعدة PostgreSQL للاختبار (scripts/pg-local.sh start تطبعها)
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
